{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"@supermemory/ai-sdk#build": { "outputs": ["dist/**"] },
		"@supermemory/memory-graph#build": { "outputs": ["dist/**"] },
		"@supermemory/tools#build": { "outputs": ["dist/**"] },
		"supermemory-browser-extension#build": { "outputs": [".output/**"] },
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"dev:app": {
			"cache": false,
			"persistent": true
		}
	}
}
